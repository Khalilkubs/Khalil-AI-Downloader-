# Khalil Video Downloader - Android UI Layout
# Kivy Language (.kv) file

<DownloadScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: 0.055, 0.067, 0.09, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: dp(10)
            
            Label:
                text: 'Khalil Video Downloader'
                font_size: dp(20)
                bold: True
                color: 0, 1, 0.533, 1
                halign: 'left'
                valign: 'middle'
            
            Button:
                text: 'History'
                size_hint_x: None
                width: dp(100)
                background_color: 0.15, 0.18, 0.25, 1
                color: 1, 1, 1, 1
                on_release: app.root.current = 'history'

            Button:
                text: 'Update'
                size_hint_x: None
                width: dp(80)
                background_color: 0, 0.831, 1, 1
                color: 0, 0, 0, 1
                on_release: root.update_ytdlp()

        # URL Input Section
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(110)
            spacing: dp(5)
            canvas.before:
                Color:
                    rgba: 0.1, 0.12, 0.16, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: 'Enter Video URL'
                font_size: dp(14)
                color: 0.69, 0.69, 0.69, 1
                size_hint_y: None
                height: dp(20)
                halign: 'left'
                valign: 'middle'

            TextInput:
                id: url_input
                hint_text: 'https://www.youtube.com/watch?v=...'
                multiline: False
                font_size: dp(14)
                background_color: 0.08, 0.1, 0.13, 1
                foreground_color: 1, 1, 1, 1
                cursor_color: 0, 1, 0.533, 1
                size_hint_y: None
                height: dp(45)
                padding: [dp(10), dp(10)]

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(10)

                Button:
                    id: fetch_btn
                    text: 'Fetch Info'
                    background_color: 0, 0.831, 1, 1
                    color: 0, 0, 0, 1
                    bold: True
                    on_release: root.fetch_video_info()

                Spinner:
                    id: quality_spinner
                    text: 'Best'
                    values: ['Best', '720p', '480p', '360p', 'Audio (m4a)']
                    background_color: 0.15, 0.18, 0.25, 1
                    color: 1, 1, 1, 1
                    size_hint_x: None
                    width: dp(150)

        # Video Info Section
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(180)
            spacing: dp(10)
            padding: dp(10)
            canvas.before:
                Color:
                    rgba: 0.1, 0.12, 0.16, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            opacity: 1 if root.has_video_info else 0

            Label:
                text: root.video_title
                font_size: dp(16)
                bold: True
                color: 1, 1, 1, 1
                size_hint_y: None
                height: dp(40)
                text_size: self.width - 20, None
                halign: 'left'
                valign: 'top'

            BoxLayout:
                size_hint_y: None
                height: dp(30)
                spacing: dp(20)

                Label:
                    text: '' + root.video_uploader
                    font_size: dp(12)
                    color: 0.69, 0.69, 0.69, 1
                    halign: 'left'

                Label:
                    text: '⏱' + root.video_duration
                    font_size: dp(12)
                    color: 0.69, 0.69, 0.69, 1
                    halign: 'left'

                Label:
                    text: root.video_views
                    font_size: dp(12)
                    color: 0.69, 0.69, 0.69, 1
                    halign: 'left'

            BoxLayout:
                size_hint_y: None
                height: dp(60)
                padding: dp(5)

                Label:
                    text: 'Video info will appear here after fetching'
                    font_size: dp(12)
                    color: 0.5, 0.5, 0.5, 1
                    halign: 'center'
                    valign: 'middle'

        # Progress Section
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(120)
            spacing: dp(5)
            padding: dp(10)
            canvas.before:
                Color:
                    rgba: 0.1, 0.12, 0.16, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: root.status_text
                font_size: dp(14)
                bold: True
                color: 0, 1, 0.533, 1
                size_hint_y: None
                height: dp(25)
                halign: 'center'

            ProgressBar:
                value: root.progress
                max: 100
                size_hint_y: None
                height: dp(20)

            BoxLayout:
                size_hint_y: None
                height: dp(25)
                spacing: dp(20)

                Label:
                    text: root.speed_text
                    font_size: dp(12)
                    color: 0.69, 0.69, 0.69, 1
                    halign: 'left'

                Label:
                    text: root.eta_text
                    font_size: dp(12)
                    color: 0.69, 0.69, 0.69, 1
                    halign: 'right'

        # Download Button
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(20)

            Button:
                id: download_btn
                text: 'Download'
                font_size: dp(18)
                bold: True
                background_color: 0, 1, 0.533, 1
                color: 0, 0, 0, 1
                disabled_color: 0.3, 0.3, 0.3, 0.5
                on_release: root.start_download()

        # Status Label
        Label:
            id: status_label
            text: '100% private. Downloads saved to phone storage.'
            font_size: dp(11)
            color: 0.5, 0.5, 0.5, 1
            size_hint_y: None
            height: dp(20)
            halign: 'center'

<HistoryScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: 0.055, 0.067, 0.09, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(10)

            Label:
                text: 'Download History'
                font_size: dp(18)
                bold: True
                color: 0, 1, 0.533, 1
                halign: 'left'
                valign: 'middle'

            Button:
                text: 'Back'
                size_hint_x: None
                width: dp(80)
                background_color: 0.15, 0.18, 0.25, 1
                color: 1, 1, 1, 1
                on_release: app.root.current = 'download'

        # History List
        RecycleView:
            id: history_rv
            viewclass: 'HistoryItem'
            do_scroll_x: False

            RecycleBoxLayout:
                default_size: None, dp(70)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'
                spacing: dp(5)
                padding: dp(5)

<HistoryItem>:
    orientation: 'vertical'
    padding: dp(10)
    spacing: dp(5)
    canvas.before:
        Color:
            rgba: 0.1, 0.12, 0.16, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: root.title
        font_size: dp(14)
        bold: True
        color: 1, 1, 1, 1
        size_hint_y: None
        height: dp(30)
        text_size: self.width - 20, None
        halign: 'left'
        valign: 'middle'

    BoxLayout:
        size_hint_y: None
        height: dp(20)
        spacing: dp(20)

        Label:
            text: root.date
            font_size: dp(11)
            color: 0.5, 0.5, 0.5, 1
            halign: 'left'

        Label:
            text: root.quality
            font_size: dp(11)
            color: 0, 0.831, 1, 1
            halign: 'right'
